FROM alpine:3.20

WORKDIR /app

RUN apk add --no-cache bash curl jq

COPY tests ./tests

CMD ["bash", "-lc", "set -euo pipefail; for item in NODE:$NODE_BASE_URL PHP:$PHP_BASE_URL JAVA:$JAVA_BASE_URL DOTNET:$DOTNET_BASE_URL; do name=${item%%:*}; url=${item#*:}; echo \"\\n=== $name integration tests ($url) ===\"; BASE_URL=\"$url\" bash tests/integration/run-integration-tests.sh; done"]
